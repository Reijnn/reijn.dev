{
  "name": "reijn.dev",
  "version": "1.0.0",
  "description": "Personal website and blog by Niels Reijn",
  "scripts": {
    "diagrams": "node scripts/render-diagrams.mjs",
    "dev": "npm run -s diagrams && hugo serve --buildDrafts --buildFuture --disableFastRender",
    "start": "npm run -s diagrams && hugo serve",
    "build": "npm run -s diagrams && hugo --minify",
    "build:preview": "npm run -s diagrams && hugo --buildDrafts --buildFuture --minify",
    "clean": "rm -rf public resources assets/diagrams"
  },
  "devDependencies": {
    "hugo-bin": "^0.166.0",
    "pele": "^1.6.0",
    "sass-embedded": "^1.105.2"
  },
  "keywords": [
    "hugo",
    "blog",
    "personal-website",
    "static-site"
  ],
  "author": "Niels Reijn <reijnn@gmail.com>",
  "license": "MIT",
  "allowScripts": {
    "hugo-bin": true
  }
}
