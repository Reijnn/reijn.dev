{
  "name": "reijn.dev",
  "version": "1.0.0",
  "description": "Personal website and blog by Niels Reijn",
  "scripts": {
    "dev": "vite build --watch & hugo serve --buildDrafts --buildFuture --disableFastRender",
    "start": "vite build && hugo serve",
    "build": "vite build && hugo --minify",
    "build:preview": "vite build && hugo --buildDrafts --buildFuture --minify",
    "clean": "rm -rf public resources",
    "deploy": "npm run build && firebase deploy",
    "deploy:preview": "npm run build:preview && firebase deploy",
    "check": "hugo version && hugo version | grep -q extended || (echo 'Error: Hugo extended is required' && exit 1)",
    "lint": "echo 'No linting configured'"
  },
  "devDependencies": {
    "hugo-extended": "^0.158.0",
    "vite": "^8.0.0"
  },
  "keywords": [
    "hugo",
    "blog",
    "personal-website",
    "static-site"
  ],
  "author": "Niels Reijn <reijnn@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "mermaid": "^11.13.0",
    "typewriter-effect": "^2.22.0"
  }
}
